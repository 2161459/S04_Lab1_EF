{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  //Il permet à ton application de savoir où se trouve ta base de données SQL Server et comment s'y connecter.
  //La valeur (localdb)\\mssqllocaldb pour Server peut changer si vous travaillez à la maison. Il faut mettre le nom du serveur de BD installé sur votre machine.
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ZombiePartyEF;Trusted_Connection=True;MultipleActiveResultSets=True"
  }

}
